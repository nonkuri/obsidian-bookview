{
  "name": "obsidian-bookview",
  "version": "1.0.0",
  "description": "PDF viewer for Obsidian with two-page spread support for right-to-left (vertical Japanese) books.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "test:pdf": "node test/make-pdf.mjs",
    "test:build": "node test/build-harness.mjs",
    "test:serve": "node test/serve.mjs",
    "test:registry": "node test/registry-test.mjs",
    "test": "node test/registry-test.mjs"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "vertical-writing",
    "spread"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174"
  }
}
