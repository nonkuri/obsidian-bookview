{
  "name": "obsidian-bookview",
  "version": "1.1.1",
  "description": "PDF and EPUB viewer for Obsidian with two-page spread support for right-to-left (vertical Japanese) books.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "test:pdf": "node test/make-pdf.mjs",
    "test:epub": "node test/make-epub.mjs && node test/make-epub.mjs --vertical= --out=horizontal.epub",
    "test:build": "node test/build-harness.mjs",
    "test:serve": "node test/serve.mjs",
    "test:registry": "node test/registry-test.mjs",
    "test": "node test/registry-test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src package.json"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "epub",
    "vertical-writing",
    "spread"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
